{
  "name": "folio-books-and-authors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:server\" \"npm:server:ai\"",
    "dev:web": "vite --host 127.0.0.1",
    "server": "json-server db.json --port 3001",
    "server:ai": "node --env-file-if-exists=.env server.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "json-server": "1.0.0-beta.3",
    "vite": "^7.1.7"
  }
}
